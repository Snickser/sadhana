<?xml version="1.0" encoding="utf-8"?>
<!-- Второстепенная кнопка: сандаловая пилюля с золотой рамкой -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FFFDF7"
        android:endColor="#F7E9CE" />
    <corners android:radius="19dp" />
    <stroke
        android:width="1dp"
        android:color="#C8A15A" />
</shape>
