<?xml version="1.0" encoding="utf-8"?>
<!-- Нижняя панель: кремовый фон с золотой линией сверху -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FDF6E6" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#E8D3A9" />
        </shape>
    </item>
</layer-list>
