<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp">

            <TextView
                android:id="@+id/editDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#3E2723"
                android:textSize="17sp"
                android:textStyle="bold"
                android:text="" />

            <Button
                android:id="@+id/btnPickDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Дата"
                android:textSize="13sp"
                android:backgroundTint="#FFB74D"
                android:textColor="#4E342E" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Круги джапы"
            android:textColor="#5D4037"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnRoundsMinus"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="−"
                android:textSize="20sp"
                android:textStyle="bold"
                android:backgroundTint="#FFE0B2"
                android:textColor="#BF360C" />

            <EditText
                android:id="@+id/inRounds"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:inputType="number"
                android:maxLength="3"
                android:gravity="center"
                android:textSize="18sp"
                android:textColor="#3E2723"
                android:hint="0"
                android:background="@drawable/card_bg"
                android:padding="14dp" />

            <Button
                android:id="@+id/btnRoundsPlus"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="+"
                android:textSize="20sp"
                android:textStyle="bold"
                android:backgroundTint="#FFE0B2"
                android:textColor="#BF360C" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnR4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="4"
                android:textSize="13sp"
                android:backgroundTint="#F5E6D3"
                android:textColor="#6D4C41" />

            <Button
                android:id="@+id/btnR8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="8"
                android:textSize="13sp"
                android:backgroundTint="#F5E6D3"
                android:textColor="#6D4C41" />

            <Button
                android:id="@+id/btnR16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="16"
                android:textSize="13sp"
                android:backgroundTint="#FFE0B2"
                android:textColor="#BF360C"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnR20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="20"
                android:textSize="13sp"
                android:backgroundTint="#F5E6D3"
                android:textColor="#6D4C41" />

            <Button
                android:id="@+id/btnR25"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="25"
                android:textSize="13sp"
                android:backgroundTint="#F5E6D3"
                android:textColor="#6D4C41" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Чтение книг, минут"
            android:textColor="#5D4037"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inReading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="4"
            android:textSize="16sp"
            android:textColor="#3E2723"
            android:hint="0"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Регулярные пункты"
            android:textColor="#5D4037"
            android:textSize="14sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbWake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Подъём до 5:00"
            android:textColor="#3E2723"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbArati"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Мангала-арати"
            android:textColor="#3E2723"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbLecture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Лекция / класс"
            android:textColor="#3E2723"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbPrasadam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Только прасад"
            android:textColor="#3E2723"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbSleep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Отбой до 22:00"
            android:textColor="#3E2723"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Служение"
            android:textColor="#5D4037"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:textSize="15sp"
            android:textColor="#3E2723"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Заметки"
            android:textColor="#5D4037"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:textSize="15sp"
            android:textColor="#3E2723"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:text="Сохранить"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#E65100"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="Удалить отчёт"
            android:textSize="14sp"
            android:backgroundTint="#EF9A9A"
            android:textColor="#7F0000"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
