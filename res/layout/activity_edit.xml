<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="10dp"
            android:background="@drawable/btn_icon"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            android:contentDescription="@string/back_title" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="12dp"
            android:text="@string/edit_title"
            android:textColor="#FFF8E7"
            android:textSize="17sp"
            android:fontFamily="serif"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_lotus"
            android:contentDescription="@string/lotus" />
    </LinearLayout>

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:background="@color/cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp">

            <TextView
                android:id="@+id/editDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold"
                android:text="" />

            <Button
                android:id="@+id/btnPickDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Дата"
                android:textSize="13sp"
                android:backgroundTint="@color/gold"
                android:textColor="@color/ink" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Круги джапы"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/btnRoundsMinus"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="−"
                android:textSize="20sp"
                android:textStyle="bold"
                android:backgroundTint="@color/gold_pale"
                android:textColor="@color/maroon" />

            <EditText
                android:id="@+id/inRounds"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:layout_marginRight="6dp"
                android:inputType="number"
                android:maxLength="3"
                android:gravity="center"
                android:textSize="18sp"
                android:textColor="@color/ink"
                android:hint="0"
                android:background="@drawable/card_bg"
                android:padding="14dp" />

            <Button
                android:id="@+id/btnRoundsPlus"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="+"
                android:textSize="20sp"
                android:textStyle="bold"
                android:backgroundTint="@color/gold_pale"
                android:textColor="@color/maroon" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnR4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="4"
                android:textSize="13sp"
                android:backgroundTint="@color/gold_pale"
                android:textColor="@color/ink_soft" />

            <Button
                android:id="@+id/btnR8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="8"
                android:textSize="13sp"
                android:backgroundTint="@color/gold_pale"
                android:textColor="@color/ink_soft" />

            <Button
                android:id="@+id/btnR16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="16"
                android:textSize="13sp"
                android:backgroundTint="@color/gold_pale"
                android:textColor="@color/maroon"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnR20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="20"
                android:textSize="13sp"
                android:backgroundTint="@color/gold_pale"
                android:textColor="@color/ink_soft" />

            <Button
                android:id="@+id/btnR25"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:text="25"
                android:textSize="13sp"
                android:backgroundTint="@color/gold_pale"
                android:textColor="@color/ink_soft" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Чтение книг, минут"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inReading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="4"
            android:textSize="16sp"
            android:textColor="@color/ink"
            android:hint="0"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Регулярные пункты"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbWake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Подъём до 5:00"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbArati"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Мангала-арати"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbLecture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Лекция / класс"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbPrasadam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Только прасад"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbSleep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Отбой до 22:00"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Служение"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:textSize="15sp"
            android:textColor="@color/ink"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Заметки"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:textSize="15sp"
            android:textColor="@color/ink"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:text="Сохранить"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="Удалить отчёт"
            android:textSize="12sp"
            android:background="@drawable/btn_gold"
            android:textColor="@color/maroon"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
</LinearLayout>
