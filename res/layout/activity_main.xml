<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream">

    <!-- Шапка: лотос, название, четыре круглые кнопки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_lotus"
            android:contentDescription="@string/lotus" />

        <TextView
            android:id="@+id/header"
            style="@style/HeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:text="@string/app_name" />

        <ImageButton
            android:id="@+id/btnStats"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginLeft="4dp"
            android:padding="9dp"
            android:background="@drawable/btn_icon"
            android:src="@drawable/ic_stats"
            android:scaleType="fitCenter"
            android:contentDescription="@string/stats_title" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginLeft="4dp"
            android:padding="9dp"
            android:background="@drawable/btn_icon"
            android:src="@drawable/ic_alarm"
            android:scaleType="fitCenter"
            android:contentDescription="@string/reminder_title" />

        <ImageButton
            android:id="@+id/btnDonate"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginLeft="4dp"
            android:padding="9dp"
            android:background="@drawable/btn_icon"
            android:src="@drawable/ic_heart"
            android:scaleType="fitCenter"
            android:contentDescription="@string/donate_title" />

        <ImageButton
            android:id="@+id/btnDeleteAll"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginLeft="4dp"
            android:padding="9dp"
            android:background="@drawable/btn_icon"
            android:src="@drawable/ic_trash"
            android:scaleType="fitCenter"
            android:contentDescription="@string/delete_all_title" />
    </LinearLayout>

    <TextView
        android:id="@+id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_summary"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:lineSpacingExtra="1dp"
        android:text="" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:text="@string/empty_hint"
            android:textColor="@color/ink_soft"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Нижняя панель: мягкие «пилюли», главное действие — шафрановое -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_bar"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="Экспорт"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="@drawable/btn_gold"
            android:textColor="@color/maroon" />

        <Button
            android:id="@+id/btnImport"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:text="Импорт"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="@drawable/btn_gold"
            android:textColor="@color/maroon" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1.2"
            android:layout_marginLeft="8dp"
            android:text="Отчёт"
            android:textSize="13sp"
            android:textStyle="bold"
            android:drawableLeft="@drawable/ic_plus"
            android:drawablePadding="5dp"
            android:paddingLeft="10dp"
            android:paddingRight="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:includeFontPadding="false"
            android:gravity="center"
            android:background="@drawable/btn_primary"
            android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>
