<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cream">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnStatsBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="10dp"
            android:background="@drawable/btn_icon"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            android:contentDescription="@string/back_title" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="12dp"
            android:text="@string/stats_title"
            android:textColor="#FFF8E7"
            android:textSize="17sp"
            android:fontFamily="serif"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_lotus"
            android:contentDescription="@string/lotus" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/gold_pale"
        android:padding="8dp">

        <Button
            android:id="@+id/btnPeriod7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="7 дней"
            android:textSize="13sp"
            android:backgroundTint="@color/gold_pale"
            android:textColor="@color/maroon" />

        <Button
            android:id="@+id/btnPeriod30"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:text="30 дней"
            android:textSize="13sp"
            android:backgroundTint="@color/gold_pale"
            android:textColor="@color/maroon" />

        <Button
            android:id="@+id/btnPeriod90"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:text="90 дней"
            android:textSize="13sp"
            android:backgroundTint="@color/gold_pale"
            android:textColor="@color/maroon" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/statsSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:padding="14dp"
                android:textColor="@color/ink_soft"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:text="" />

            <ru.rolyc.sadhana.BarChartView
                android:id="@+id/chartRounds"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg" />

            <ru.rolyc.sadhana.BarChartView
                android:id="@+id/chartPoints"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg" />

            <ru.rolyc.sadhana.BarChartView
                android:id="@+id/chartReading"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/card_bg" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
