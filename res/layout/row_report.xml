<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:id="@+id/rowCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/card_bg"
        android:gravity="center_vertical">

        <!-- Шафрановая полоса у сегодняшнего дня; видимость включает адаптер.
             Обычный View, а не layer-list с android:width: этот атрибут работает только с API 23. -->
        <View
            android:id="@+id/rowBar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/kesar"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp">

            <TextView
                android:id="@+id/rowDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:maxLines="2"
                android:text="" />

            <TextView
                android:id="@+id/rowDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/ink_soft"
                android:textSize="12sp"
                android:text="" />

            <TextView
                android:id="@+id/rowMarks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/maroon"
                android:textSize="11sp"
                android:text="" />
        </LinearLayout>

        <TextView
            android:id="@+id/rowRounds"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="12dp"
            android:background="@drawable/badge_bg"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:gravity="center"
            android:textColor="@color/maroon"
            android:textSize="14sp"
            android:textStyle="bold"
            android:text="" />
    </LinearLayout>
</LinearLayout>
